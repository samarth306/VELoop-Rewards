  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName && pm.info.requestName.includes('Withdrawal')) {",
          "  pm.collectionVariables.set('requestId', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
