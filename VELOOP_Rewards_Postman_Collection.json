          "description": "Login and save the returned JWT.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) pm.collectionVariables.set('accessToken', data.access_token);",
                  "}"
                ]
              }
            }
