    {
      "name": "Payout",
      "item": [
        {
          "name": "GET Payout Options",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payout-options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payout-options"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (Array.isArray(data.options) && data.options.length) {",
                  "    pm.collectionVariables.set('payoutOptionId', data.options[0].method_id || data.options[0].id || '');",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Single Payout Option",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payout-options/{{payoutOptionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payout-options",
                "{{payoutOptionId}}"
              ]
            }
          }
        },
        {
          "name": "POST My Withdrawal — manual test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10,\n  \"payout_option_id\": \"{{payoutOptionId}}\",\n  \"payout_details\": {\n    \"upi_id\": \"example@upi\"\n  },\n  \"request_id\": \"{{requestId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wallet/me/withdrawal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "me",
                "withdrawal"
              ]
            }
          },
          "description": "Manual test only. Do not execute against a real account unless you intentionally want to create a real withdrawal. Use a fresh unique requestId."
        }
      ]
    },
