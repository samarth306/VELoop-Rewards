# ============================================================
# VELOOP Rewards — Environment Variables Template
# ============================================================
# Copy this file to .env for local development.
# Replace placeholder values with your own local/deployment values.
#
# IMPORTANT:
# - NEVER commit .env to GitHub.
# - NEVER put real MongoDB credentials, JWT secrets,
#   SMTP passwords, or admin secrets in this file.
# - This file is only a safe template.
# ============================================================


# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

PORT=8000


# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------

MONGO_URI=your_mongodb_connection_string
DB_NAME=veloop_rewards


# ------------------------------------------------------------
# Authentication / JWT
# ------------------------------------------------------------

JWT_SECRET=replace_with_a_long_random_jwt_secret


# ------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------
# Comma-separated frontend origins.
#
# Local example:
# http://localhost:5173,http://localhost:5174
#
# Production example:
# https://veloop-rewards-frontend-ggzf.onrender.com

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,https://veloop-rewards-frontend-ggzf.onrender.com

# Used for password-reset links.
FRONTEND_URL=https://veloop-rewards-frontend-ggzf.onrender.com


# ------------------------------------------------------------
# Admin / Maintenance
# ------------------------------------------------------------
# Keep these values empty in the template.
# Set real random secrets only in local .env / Render Environment.

ADMIN_REWARD_KEY=
ADMIN_WITHDRAWAL_KEY=
ADMIN_RESET_SECRET=


# ------------------------------------------------------------
# Password reset email delivery
# Preferred on Render without a custom domain: Gmail API over HTTPS.
# Create Google OAuth credentials and a refresh token with gmail.send scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Optional Resend HTTPS provider (requires a verified sender domain in production).
RESEND_API_KEY=
RESEND_FROM=

# SMTP fallback only for local/hosts that permit outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
